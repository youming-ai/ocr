{
  "name": "ocr",
  "version": "2.0.0",
  "private": true,
  "description": "On-device OCR powered by PaddleOCR PP-OCRv6. Extract text from images and PDFs — source files never leave your browser.",
  "homepage": "https://ocr.um1ng.me",
  "repository": "https://github.com/youming-ai/ocr",
  "bugs": "https://github.com/youming-ai/ocr/issues",
  "keywords": [
    "ocr",
    "text-recognition",
    "paddleocr",
    "on-device",
    "privacy",
    "browser",
    "wasm",
    "pdf",
    "image-to-text"
  ],
  "author": "Youming <ikashue@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun src/dev-server.ts & vite",
    "dev:api": "bun src/dev-server.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "routes:generate": "tsr generate",
    "check:worker": "wrangler deploy --dry-run",
    "preview": "vite preview",
    "start": "bun src/prod-server.ts",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome check ./src",
    "lint:fix": "biome check --fix ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf node_modules dist .output",
    "postinstall": "mkdir -p public/ort && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm public/ort/ && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.4",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
